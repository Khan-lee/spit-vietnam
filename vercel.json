{
  "routes": [
    { "src": "/about", "dest": "/about.html" },
    { "src": "/products", "dest": "/products.html" },
    { "src": "/tin-tuc", "dest": "/tin-tuc.html" },
    { "src": "/product/(?<slug>[^/]+)", "dest": "/product/$slug.html" },
    { "src": "/post/(?<slug>[^/]+)", "dest": "/post/$slug.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}