# Sao chép file này thành ".env" và điền giá trị thật. KHÔNG commit file .env.

# Google Gemini — dùng cho trợ lý AI (nếu chạy chung codebase)
GEMINI_API_KEY=

# Email (SMTP) — luồng tự động gửi báo giá PDF khi khách yêu cầu
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=            # Với Gmail: dùng App Password 16 ký tự, KHÔNG dùng mật khẩu tài khoản
EMAIL_FROM=

# Lark Base — đồng bộ đơn hàng sang bảng
LARK_APP_ID=
LARK_APP_SECRET=
LARK_APP_TOKEN=
LARK_TABLE_ID=
